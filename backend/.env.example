# Copiar a backend/.env y ajustar. backend/.env NO se comparte (puede tener contraseñas).

DEBUG=True
# Obligatoria con DEBUG=False:
# SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Santiago

# ── Datos de la planta (separados por coma). Sin definir se usan valores DEMO ──
# Marcas del formulario de ingreso (la primera es la principal); "OTRO" siempre está disponible.
# MARCAS=MI EMPRESA S.A.,OTRA MARCA SpA
# Inspectores con que parte la lista (solo al migrar por primera vez; luego se editan en /admin/).
# INSPECTORES_INICIALES=NOMBRE APELLIDO,NOMBRE APELLIDO

# ── Base de datos ──
# Desarrollo: SQLite (archivo backend/db.sqlite3)
DB_ENGINE=sqlite

# SQL Server (descomentar; pip install -r requirements-sqlserver.txt):
# DB_ENGINE=mssql
# DB_HOST=localhost\SQLEXPRESS
# DB_PORT=
# DB_NAME=ControlDimensional
# Dejar DB_USER vacío para autenticación de Windows:
# DB_USER=
# DB_PASSWORD=
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_EXTRA_PARAMS=TrustServerCertificate=yes
